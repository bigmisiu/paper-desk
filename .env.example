# Optional. If set, daily bars come from Polygon aggregates (grouped daily + prev close).
# If empty or unset, Yahoo Chart v8 is used. The scanner never requires this key.
POLYGON_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact. Do not leave this blank
# on a public VPS — put a real email you monitor.
SEC_USER_AGENT=paper-desk/0.1 (research; contact: operator@localhost)


# Gekko inbound webhook. Copy URL + sender key from the Gordan Gekko
# routine "Paper desk scan inbound". Never commit the real key.
DESK_WEBHOOK_URL=
DESK_WEBHOOK_SECRET=
